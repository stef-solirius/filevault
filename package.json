{
  "name": "filevault",
  "version": "1.0.0",
  "description": "FileVault - Cloud Storage File Management Application",
  "private": true,
  "scripts": {
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:aws": "jest tests/aws-s3",
    "test:azure": "jest tests/azure-sa",
    "mcp:server": "node mcp/server.js",
    "mcp:test": "node mcp/client-test.js",
    "mcp:devops": "node mcp/devops-server.js",
    "mcp:devops:test": "node mcp/devops-test.js",
    "mcp:integration:test": "node mcp/integration-test.js",
    "deploy:checks": "node mcp/deployment-automation.js checks",
    "deploy:dev": "node mcp/deployment-automation.js deploy dev",
    "deploy:staging": "node mcp/deployment-automation.js deploy staging",
    "deploy:production": "node mcp/deployment-automation.js deploy production"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.705.0",
    "@aws-sdk/lib-storage": "^3.705.0",
    "@azure/storage-blob": "^12.29.1",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "applicationinsights": "^2.9.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "multer": "^1.4.5-lts.1",
    "prom-client": "^15.1.0",
    "winston": "^3.11.0",
    "winston-azure-application-insights": "^4.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/node_modules/**",
      "!src/**/public/**"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/__tests__/**/*.js"
    ]
  }
}
